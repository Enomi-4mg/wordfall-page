    "music",
    "nature",
    "philosophy",
    "science",
    "society",
    "space",
    "study",
    "tech",
    "time",
    "travel",
    "work"
  ],
  "note": "category is retired. concept_id is reserved for future multilingual linking. Counts are intentionally omitted because data files are the source of truth."
