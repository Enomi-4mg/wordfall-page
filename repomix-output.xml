        <p id="importStatus" class="mini-status"></p>
      </section>
    </div>
  </aside>

  <aside id="bookmarksDrawer" class="bookmarks-drawer" aria-label="Bookmarks drawer" aria-hidden="true">
    <div class="panel-header">
      <div>
        <p class="panel-kicker">Saved</p>
        <h1>Bookmarks</h1>
      </div>
      <button id="closeBookmarksButton" class="icon-button compact" type="button" aria-label="Close bookmarks">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div id="bookmarksList" class="bookmarks-list"></div>
  </aside>

  <div id="modalBackdrop" class="modal-backdrop" aria-hidden="true">
    <article id="detailModal" class="detail-modal" role="dialog" aria-modal="true" aria-labelledby="modalWord" tabindex="-1">
      <button id="closeModalButton" class="icon-button compact modal-close" type="button" aria-label="Close detail">
        <i data-lucide="x"></i>
      </button>
      <div class="modal-meta">
        <span id="modalLevel"></span>
        <span id="modalLang"></span>
        <span id="modalCategory"></span>
        <span id="modalGenre"></span>
      </div>
      <h2 id="modalWord"></h2>
      <p id="modalReading" class="modal-reading"></p>
      <p id="modalDesc" class="modal-desc"></p>
