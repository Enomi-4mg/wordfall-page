      <div>
        <p class="panel-kicker">Wordfall</p>
        <h1>設定</h1>
      </div>
      <button id="closeSettingsButton" class="icon-button compact" type="button" aria-label="Close settings">
        <i data-lucide="x"></i>
      </button>
    </div>

    <div class="panel-scroll">
