<file path="style.css">
/* style.css */

/* Base */
:root {
  --bg: #ffffff;
  --ink: #070707;
  --muted: #676767;
  --line: #d8d8d8;
  --soft: #f5f5f5;
  --panel: rgba(255, 255, 255, 0.94);
  --shadow: 0 24px 80px rgba(0, 0, 0, 0.14);
  --ui-font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --word-font: "Cormorant Garamond", Georgia, "Times New Roman", serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--ui-font);
  letter-spacing: 0;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-thumb {
  background: #cfcfcf;
}

::-webkit-scrollbar-track {
  background: transparent;
}

/* App Shell */
.app-shell {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.025) 1px, transparent 1px),
    linear-gradient(180deg, rgba(0, 0, 0, 0.018) 1px, transparent 1px),
    var(--bg);
  background-size: 64px 64px, 64px 64px, auto;
}

.word-cascade {
  position: absolute;
  inset: 0;
  overflow: hidden;
  user-select: none;
}

.top-left-controls,
.top-right-control {
  position: fixed;
  z-index: 30;
}

.top-left-controls {
  top: 18px;
  left: 18px;
  display: flex;
  gap: 8px;
}

.top-right-control {
  top: 18px;
  right: 18px;
}

.status-message {
  position: fixed;
  z-index: 20;
  left: 50%;
  bottom: 44px;
  transform: translateX(-50%);
  max-width: min(520px, calc(100vw - 40px));
  padding: 7px 12px;
  border: 1px solid transparent;
  background: rgba(255, 255, 255, 0.78);
  color: var(--muted);
  font-size: 12px;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease, border-color 220ms ease;
}

.status-message.is-visible {
  border-color: var(--line);
  opacity: 1;
}

/* Controls */
.icon-button {
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.76);
  color: var(--ink);
  backdrop-filter: blur(12px);
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
}

.icon-button:hover,
.icon-button:focus-visible,
.text-button:hover,
.text-button:focus-visible {
  border-color: var(--ink);
  background: #fff;
  outline: none;
}

.icon-button:active,
.text-button:active {
  transform: translateY(1px);
}

.icon-button svg,
.text-button svg,
.drop-zone svg {
  width: 18px;
  height: 18px;
  stroke-width: 1.6;
}

.icon-button.compact {
  width: 34px;
  height: 34px;
  background: transparent;
}

.text-button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  padding: 8px 12px;
  color: var(--ink);
  font-size: 13px;
  cursor: pointer;
  transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
}

.text-button.primary {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}

.text-button.primary:hover,
.text-button.primary:focus-visible {
  background: #222;
}

/* Floating Words */
.floating-word {
  appearance: none;
  position: absolute;
  top: 0;
  left: 0;
  border: 0;
  background: transparent;
  padding: 0;
  font-family: var(--word-font);
  line-height: 1;
  color: rgba(0, 0, 0, var(--word-alpha, 0.5));
  white-space: nowrap;
  will-change: transform, opacity;
  text-rendering: optimizeLegibility;
  cursor: pointer;
  transition: color 180ms ease, filter 180ms ease, letter-spacing 180ms ease;
}

.floating-word:hover,
.floating-word:focus-visible {
  color: rgba(0, 0, 0, var(--word-hover-alpha, 0.92));
  filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.24));
  letter-spacing: 0.02em;
  outline: none;
}

/* Panels */
.side-panel,
.bookmarks-drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  z-index: 50;
  width: min(410px, calc(100vw - 34px));
  background: var(--panel);
  backdrop-filter: blur(18px);
  box-shadow: var(--shadow);
  transition: transform 260ms ease;
}

.side-panel {
  left: 0;
  border-right: 1px solid var(--line);
  transform: translateX(-105%);
}

.bookmarks-drawer {
  right: 0;
  border-left: 1px solid var(--line);
  transform: translateX(105%);
}

.side-panel.is-open,
.bookmarks-drawer.is-open {
  transform: translateX(0);
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 22px 16px;
  border-bottom: 1px solid var(--line);
}

.panel-kicker {
  margin: 0 0 3px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

.panel-header h1 {
  margin: 0;
  font-size: 22px;
  font-weight: 500;
}

.panel-scroll,
.bookmarks-list {
  height: calc(100% - 82px);
  overflow-y: auto;
  padding: 18px 22px 28px;
  scrollbar-width: thin;
}

.setting-section {
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}

.setting-section:first-child {
  padding-top: 0;
}

.setting-section h2 {
  margin: 0 0 13px;
  font-size: 13px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.field-label {
  display: flex;
  justify-content: space-between;
  margin: 12px 0 7px;
  color: var(--muted);
  font-size: 12px;
}

.control-input,
.json-input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  outline: none;
}

.control-input {
  height: 40px;
  padding: 0 10px;
}

.json-input {
  min-height: 132px;
  resize: vertical;
  padding: 10px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12px;
  line-height: 1.45;
}

.control-input:focus,
.json-input:focus {
  border-color: var(--ink);
}

.range-input {
  width: 100%;
  accent-color: var(--ink);
}

.drop-zone {
  position: relative;
  display: flex;
  min-height: 82px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7px;
  margin-top: 14px;
  border: 1px dashed #a9a9a9;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.58);
  color: var(--muted);
  font-size: 13px;
  text-align: center;
}

.drop-zone.is-dragging,
.drop-zone:focus-visible {
  border-color: var(--ink);
  color: var(--ink);
  outline: none;
}

.drop-zone input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.drop-zone small {
  color: #8a8a8a;
  font-size: 11px;
  pointer-events: none;
}

.drop-zone code {
  color: var(--ink);
}

.mini-status {
  min-height: 18px;
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.language-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.language-card,
.level-button {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  cursor: pointer;
  transition: border-color 160ms ease, background 160ms ease;
}

.language-card {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 9px 10px;
  font-size: 13px;
}

.language-card input {
  accent-color: var(--ink);
}

.language-card:has(input:checked),
.level-button.is-active {
  border-color: var(--ink);
  background: var(--soft);
}

.level-buttons {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 7px;
}

.level-button {
  min-height: 38px;
  font-size: 13px;
}

.button-row {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

/* Bookmarks */
.bookmark-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 34px;
  gap: 10px;
  width: 100%;
  border-bottom: 1px solid var(--line);
  padding: 13px 0;
}

.bookmark-open {
  min-width: 0;
  border: 0;
  background: transparent;
  padding: 0;
  text-align: left;
  cursor: pointer;
}

.bookmark-word {
  display: block;
  margin-bottom: 5px;
  font-family: var(--word-font);
  font-size: 24px;
  line-height: 1.1;
}

.bookmark-meta,
.bookmark-preview {
  display: block;
  color: var(--muted);
  font-size: 12px;
}

.bookmark-preview {
  margin-top: 6px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  margin: 28px 0;
  color: var(--muted);
  font-family: var(--word-font);
  font-size: 24px;
  line-height: 1.25;
}

/* Modal */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(255, 255, 255, 0.68);
  opacity: 0;
  pointer-events: none;
  transition: opacity 200ms ease;
}

.modal-backdrop.is-open {
  opacity: 1;
  pointer-events: auto;
}

.detail-modal {
  position: relative;
  width: min(620px, 100%);
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow);
  padding: 34px;
  transform: scale(0.965) translateY(8px);
  transition: transform 200ms ease;
}

.modal-backdrop.is-open .detail-modal {
  transform: scale(1) translateY(0);
}

.modal-close {
  position: absolute;
  top: 14px;
  right: 14px;
}

.modal-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 20px;
}

.modal-meta span {
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 4px 8px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.detail-modal h2 {
  margin: 0;
  font-family: var(--word-font);
  font-size: clamp(46px, 10vw, 86px);
  font-weight: 400;
  line-height: 0.98;
}

.modal-reading {
  min-height: 22px;
  margin: 12px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.modal-desc {
  margin: 22px 0 28px;
  color: #202020;
  font-family: var(--word-font);
  font-size: 24px;
  line-height: 1.42;
}

.modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

/* Responsive */
@media (max-width: 640px) {
  .top-left-controls {
    top: 12px;
    left: 12px;
  }

  .top-right-control {
    top: 12px;
    right: 12px;
  }

  .icon-button {
    width: 38px;
    height: 38px;
  }

  .panel-header {
    padding: 19px 18px 14px;
  }

  .panel-scroll,
  .bookmarks-list {
    padding: 16px 18px 24px;
  }

  .language-grid {
    grid-template-columns: 1fr;
  }

  .detail-modal {
    padding: 28px 20px 22px;
  }

  .modal-desc {
    font-size: 21px;
  }
}
