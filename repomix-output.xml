// app.js

/* 1. CONSTANTS */
const SUPPORTED_LANGUAGES = [
  { code: "ja", label: "Japanese", file: "data/ja.json" },
  { code: "en", label: "English", file: "data/en.json" },
  { code: "zh", label: "Chinese", file: "data/zh.json" },
  { code: "ko", label: "Korean", file: "data/ko.json" },
  { code: "fr", label: "French", file: "data/fr.json" },
  { code: "de", label: "German", file: "data/de.json" },
  { code: "it", label: "Italian", file: "data/it.json" }
];

const VALID_LANGS = new Set(SUPPORTED_LANGUAGES.map((lang) => lang.code));
const VALID_CATEGORIES = new Set(["vocabulary", "tech", "custom"]);
const GENRE_LABELS = {
  art: "Art",
  body: "Body",
  city: "City",
  daily: "Daily",
  design: "Design",
  emotion: "Emotion",
  food: "Food",
  history: "History",
  media: "Media",
  music: "Music",
  nature: "Nature",
  philosophy: "Philosophy",
  science: "Science",
  society: "Society",
  space: "Space",
  study: "Study",
  tech: "Tech",
  time: "Time",
  travel: "Travel",
  work: "Work",
  custom: "Custom"
};
const GENRE_ORDER = Object.keys(GENRE_LABELS);
const LEVELS = [1, 2, 3, 4, 5];
const STORAGE_KEYS = {
  settings: "wordfall.settings",
  bookmarks: "wordfall.bookmarks",
  customWords: "wordfall.customWords"
};
const DEFAULT_SETTINGS = {
  languages: ["ja"],
  levels: [1, 2, 3, 4, 5],
  category: "all",
  genre: "all",
  volume: 0.35,
  speed: 1,
  density: 30,
  audioMode: "ambient"
};

/* 2. STATE */
const state = {
  vocabulary: [],
  customWords: [],
  loadedLanguages: new Set(),
  failedLanguages: new Set(),
  activeWords: [],
  filteredWords: [],
  settings: { ...DEFAULT_SETTINGS },
  bookmarks: [],
  selectedWord: null,
  dataLoading: false,
  paused: false,
  lastFrame: 0,
  lastSpawn: 0,
  statusTimer: null,
  audio: {
    context: null,
    gain: null,
    sourceMode: "ambient",
    muted: true,
    noiseNode: null,
    lowpass: null,
    highpass: null,
    mediaElement: null,
    mediaSource: null,
    objectUrl: null
  }
};

/* 3. DOM REFERENCES */
const dom = {
  cascade: document.getElementById("wordCascade"),
  settingsButton: document.getElementById("settingsButton"),
  soundButton: document.getElementById("soundButton"),
  bookmarkButton: document.getElementById("bookmarkButton"),
  settingsPanel: document.getElementById("settingsPanel"),
  closeSettingsButton: document.getElementById("closeSettingsButton"),
  bookmarksDrawer: document.getElementById("bookmarksDrawer"),
  closeBookmarksButton: document.getElementById("closeBookmarksButton"),
  bookmarksList: document.getElementById("bookmarksList"),
  statusMessage: document.getElementById("statusMessage"),
  audioMode: document.getElementById("audioMode"),
  volumeSlider: document.getElementById("volumeSlider"),
  volumeValue: document.getElementById("volumeValue"),
  audioDropZone: document.getElementById("audioDropZone"),
  audioFileInput: document.getElementById("audioFileInput"),
  audioStatus: document.getElementById("audioStatus"),
  languageGrid: document.getElementById("languageGrid"),
  speedSlider: document.getElementById("speedSlider"),
  speedValue: document.getElementById("speedValue"),
  densitySlider: document.getElementById("densitySlider"),
  densityValue: document.getElementById("densityValue"),
  levelButtons: document.getElementById("levelButtons"),
  categorySelect: document.getElementById("categorySelect"),
  genreSelect: document.getElementById("genreSelect"),
  jsonInput: document.getElementById("jsonInput"),
  templateButton: document.getElementById("templateButton"),
  importButton: document.getElementById("importButton"),
  importStatus: document.getElementById("importStatus"),
  modalBackdrop: document.getElementById("modalBackdrop"),
  detailModal: document.getElementById("detailModal"),
  closeModalButton: document.getElementById("closeModalButton"),
  modalLevel: document.getElementById("modalLevel"),
  modalLang: document.getElementById("modalLang"),
  modalCategory: document.getElementById("modalCategory"),
  modalGenre: document.getElementById("modalGenre"),
  modalWord: document.getElementById("modalWord"),
  modalReading: document.getElementById("modalReading"),
  modalDesc: document.getElementById("modalDesc"),
  googleButton: document.getElementById("googleButton"),
  wikiButton: document.getElementById("wikiButton"),
  saveButton: document.getElementById("saveButton")
};

/* 4. DATA LOADING */
async function loadLanguage(langCode) {
  const lang = SUPPORTED_LANGUAGES.find((item) => item.code === langCode);
  if (!lang || state.loadedLanguages.has(langCode) || state.failedLanguages.has(langCode)) return;

  try {
    const response = await fetch(lang.file, { cache: "no-store" });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    const data = await response.json();
    if (!Array.isArray(data)) throw new Error("JSON root must be an array.");
    const normalized = data.map((item) => normalizeVocabularyItem(item, "builtin")).filter(Boolean);
    state.vocabulary.push(...normalized);
    state.loadedLanguages.add(langCode);
    updateFilteredWords();
    renderGenreOptions();
  } catch (error) {
    state.failedLanguages.add(langCode);
    showStatus(`Could not load ${lang.label}. Run through a local static server if opened as a file.`);
  }
}

async function loadInitialData() {
  state.dataLoading = true;
  await Promise.all(SUPPORTED_LANGUAGES.map((lang) => loadLanguage(lang.code)));
  state.dataLoading = false;
  renderGenreOptions();
  updateFilteredWords();
  if (!state.vocabulary.length) {
    showStatus("No vocabulary files loaded. Try serving with python -m http.server.");
  }
}

function normalizeVocabularyItem(item, source) {
  if (!item || typeof item !== "object") return null;
  const name = cleanText(item.name);
  const desc = cleanText(item.desc);
  const lang = cleanText(item.lang).toLowerCase();
  if (!name || !desc || !VALID_LANGS.has(lang)) return null;

  const level = Number.parseInt(item.lv, 10);
  let category = cleanText(item.category).toLowerCase();
  if (!VALID_CATEGORIES.has(category)) category = source === "custom" ? "custom" : "vocabulary";
  let genre = cleanText(item.genre).toLowerCase();
  if (!isValidGenre(genre)) genre = source === "custom" ? "custom" : "daily";

  return {
    name,
    desc,
    lang,
    reading: cleanText(item.reading),
    lv: LEVELS.includes(level) ? level : 1,
    category,
    genre,
    id: createWordId({ name, desc, lang })
  };
}

function cleanText(value) {
  return typeof value === "string" ? value.trim() : "";
}

function createWordId(item) {
  return `${item.lang}::${item.name}::${item.desc}`.toLowerCase();
}

function isValidGenre(value) {
  return /^[a-z][a-z0-9-]{0,31}$/.test(value);
}

function updateFilteredWords() {
  state.filteredWords = state.vocabulary.filter((item) => {
    const languageMatch = state.settings.languages.includes(item.lang);
    const levelMatch = state.settings.levels.includes(item.lv);
    const categoryMatch = state.settings.category === "all" || item.category === state.settings.category;
    const genreMatch = state.settings.genre === "all" || item.genre === state.settings.genre;
    return languageMatch && levelMatch && categoryMatch && genreMatch;
  });

  if (!state.dataLoading && !state.filteredWords.length && state.vocabulary.length) {
    showStatus("No words match the current filters.");
  }
}

/* 5. AUDIO ENGINE */
async function ensureAudioContext() {
  if (!state.audio.context) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) {
      dom.audioStatus.textContent = "Web Audio API is not supported in this browser.";
      return false;
    }
    state.audio.context = new AudioContextClass();
    state.audio.gain = state.audio.context.createGain();
    state.audio.gain.gain.value = state.audio.muted ? 0 : state.settings.volume;
    state.audio.gain.connect(state.audio.context.destination);
  }
  if (state.audio.context.state === "suspended") {
    await state.audio.context.resume();
  }
  return true;
}

async function toggleSound() {
  const ready = await ensureAudioContext();
  if (!ready) return;
  state.audio.muted = !state.audio.muted;
  applyVolume();
  updateSoundButton();
  if (!state.audio.muted) startAudioSource();
  saveSettings();
}

function applyVolume() {
  if (!state.audio.gain) return;
  state.audio.gain.gain.setTargetAtTime(state.audio.muted ? 0 : state.settings.volume, state.audio.context.currentTime, 0.03);
}

function updateSoundButton() {
  dom.soundButton.setAttribute("aria-pressed", String(!state.audio.muted));
  dom.soundButton.setAttribute("aria-label", state.audio.muted ? "Turn sound on" : "Turn sound off");
  dom.soundButton.innerHTML = state.audio.muted ? '<i data-lucide="volume-x"></i>' : '<i data-lucide="volume-2"></i>';
  refreshIcons();
}

function startAudioSource() {
  if (!state.audio.context || state.audio.muted) return;
  stopAudioSource();
  state.audio.sourceMode = state.settings.audioMode;
  if (state.audio.sourceMode === "custom" && state.audio.mediaElement) {
    startCustomAudio();
  } else {
    startAmbientNoise();
  }
}

function startAmbientNoise() {
  const ctx = state.audio.context;
  const bufferSize = 4096;
  let lastOut = 0;
  const noise = ctx.createScriptProcessor(bufferSize, 1, 1);
  const highpass = ctx.createBiquadFilter();
  const lowpass = ctx.createBiquadFilter();

  highpass.type = "highpass";
  highpass.frequency.value = 82;
  lowpass.type = "lowpass";
  lowpass.frequency.value = 380;

  noise.onaudioprocess = (event) => {
    const output = event.outputBuffer.getChannelData(0);
    for (let i = 0; i < output.length; i += 1) {
      const white = Math.random() * 2 - 1;
      lastOut = (lastOut + 0.02 * white) / 1.02;
      output[i] = lastOut * 3.5;
    }
  };

  noise.connect(highpass);
  highpass.connect(lowpass);
  lowpass.connect(state.audio.gain);
  state.audio.noiseNode = noise;
  state.audio.highpass = highpass;
  state.audio.lowpass = lowpass;
  dom.audioStatus.textContent = "Ambient generator is active.";
}

function startCustomAudio() {
  const audio = state.audio.mediaElement;
  audio.loop = true;
  audio.volume = 1;
  if (!state.audio.mediaSource) {
    state.audio.mediaSource = state.audio.context.createMediaElementSource(audio);
  }
  state.audio.mediaSource.connect(state.audio.gain);
  audio.play().then(() => {
    dom.audioStatus.textContent = "Custom audio is looping.";
  }).catch(() => {
    dom.audioStatus.textContent = "Click Sound On again to start custom audio.";
  });
}

function stopAudioSource() {
  if (state.audio.noiseNode) {
    state.audio.noiseNode.disconnect();
    state.audio.noiseNode.onaudioprocess = null;
    state.audio.noiseNode = null;
  }
  if (state.audio.highpass) {
    state.audio.highpass.disconnect();
    state.audio.highpass = null;
  }
  if (state.audio.lowpass) {
    state.audio.lowpass.disconnect();
    state.audio.lowpass = null;
  }
  if (state.audio.mediaSource) {
    try {
      state.audio.mediaSource.disconnect();
    } catch (error) {
      // Already disconnected.
    }
  }
  if (state.audio.mediaElement) state.audio.mediaElement.pause();
}

function handleAudioFile(file) {
  if (!file || !file.type.startsWith("audio/")) {
    dom.audioStatus.textContent = "Please choose a browser-supported audio file.";
    return;
  }
  if (state.audio.mediaElement) state.audio.mediaElement.pause();
  if (state.audio.mediaSource) {
    try {
      state.audio.mediaSource.disconnect();
    } catch (error) {
      // Already disconnected.
    }
    state.audio.mediaSource = null;
  }
  if (state.audio.objectUrl) URL.revokeObjectURL(state.audio.objectUrl);
  state.audio.objectUrl = URL.createObjectURL(file);
  state.audio.mediaElement = new Audio(state.audio.objectUrl);
  state.audio.mediaElement.loop = true;
  dom.audioStatus.textContent = `${file.name} is ready.`;
  if (state.settings.audioMode === "custom" && !state.audio.muted) startAudioSource();
}

/* 6. WORD CASCADE LOOP */
function animationLoop(timestamp) {
  if (!state.lastFrame) state.lastFrame = timestamp;
  const delta = Math.min(42, timestamp - state.lastFrame);
  state.lastFrame = timestamp;

  if (!state.paused) {
    spawnWords(timestamp);
    moveWords(delta, timestamp);
  }

  requestAnimationFrame(animationLoop);
}

function spawnWords(timestamp) {
  if (!state.filteredWords.length) return;
  const maxWords = state.settings.density;
  if (state.activeWords.length >= maxWords) return;
  const spawnDelay = Math.max(80, 950 - maxWords * 6);
  if (timestamp - state.lastSpawn < spawnDelay) return;
  state.lastSpawn = timestamp;
  createFloatingWord();
}

function createFloatingWord() {
  const item = state.filteredWords[Math.floor(Math.random() * state.filteredWords.length)];
  if (!item) return;

  const minSize = 10;
  const maxSize = 88;
  const size = randomBetween(minSize, maxSize);
  const sizeRatio = (size - minSize) / (maxSize - minSize);
  const depth = 0.72 + sizeRatio * 0.72 + randomBetween(-0.05, 0.05);
  const opacity = 0.14 + sizeRatio * 0.84;
  const hoverOpacity = Math.min(1, opacity + 0.18);
  const word = {
    item,
    x: randomBetween(2, 92),
    y: -60,
    speed: randomBetween(0.018, 0.09) * depth,
    size,
    phase: randomBetween(0, Math.PI * 2),
    sway: randomBetween(6, 34),
    opacity,
    depth
  };

  const el = document.createElement("button");
  el.type = "button";
  el.className = "floating-word";
  el.textContent = item.name;
  el.style.fontSize = `${size}px`;
  el.style.setProperty("--word-alpha", opacity.toFixed(3));
  el.style.setProperty("--word-hover-alpha", hoverOpacity.toFixed(3));
  el.style.zIndex = String(Math.round(depth * 10));
  el.setAttribute("aria-label", `Open ${item.name}`);
  el.addEventListener("click", () => openModal(item));
  word.el = el;
  state.activeWords.push(word);
  dom.cascade.appendChild(el);
}

function moveWords(delta, timestamp) {
  const height = window.innerHeight;
  for (let i = state.activeWords.length - 1; i >= 0; i -= 1) {
    const word = state.activeWords[i];
    word.y += delta * word.speed * state.settings.speed;
    const sway = Math.sin(timestamp * 0.0008 + word.phase) * word.sway;
    word.el.style.transform = `translate3d(calc(${word.x}vw + ${sway}px), ${word.y}px, 0) scale(${word.depth})`;

    if (word.y > height + 90) {
      word.el.remove();
      state.activeWords.splice(i, 1);
    }
  }
}

function clearActiveWords() {
  state.activeWords.forEach((word) => word.el.remove());
  state.activeWords = [];
}

function randomBetween(min, max) {
  return min + Math.random() * (max - min);
}

/* 7. MODAL */
function openModal(item) {
  state.selectedWord = item;
  state.paused = true;
  dom.modalLevel.textContent = `Lv${item.lv}`;
  dom.modalLang.textContent = item.lang;
  dom.modalCategory.textContent = `category: ${item.category}`;
  dom.modalGenre.textContent = `genre: ${item.genre}`;
  dom.modalWord.textContent = item.name;
  dom.modalReading.textContent = item.reading || " ";
  dom.modalDesc.textContent = item.desc;
  updateSaveButton();
  dom.modalBackdrop.classList.add("is-open");
  dom.modalBackdrop.setAttribute("aria-hidden", "false");
  dom.detailModal.focus();
  refreshIcons();
}

function closeModal() {
  dom.modalBackdrop.classList.remove("is-open");
  dom.modalBackdrop.setAttribute("aria-hidden", "true");
  state.selectedWord = null;
  state.paused = false;
}

function searchSelectedWord(site) {
  if (!state.selectedWord) return;
  const query = encodeURIComponent(state.selectedWord.name);
  const url = site === "wiki"
    ? `https://www.wikipedia.org/search-redirect.php?search=${query}`
    : `https://www.google.com/search?q=${query}`;
  window.open(url, "_blank", "noopener,noreferrer");
}

/* 8. SETTINGS PANEL */
function renderSettingsControls() {
  dom.languageGrid.innerHTML = SUPPORTED_LANGUAGES.map((lang) => `
    <label class="language-card">
      <input type="checkbox" value="${lang.code}" ${state.settings.languages.includes(lang.code) ? "checked" : ""}>
      <span>${lang.label}</span>
    </label>
  `).join("");

  dom.levelButtons.innerHTML = LEVELS.map((level) => `
    <button class="level-button ${state.settings.levels.includes(level) ? "is-active" : ""}" type="button" data-level="${level}" aria-pressed="${state.settings.levels.includes(level)}">Lv${level}</button>
  `).join("");

  dom.audioMode.value = state.settings.audioMode;
  dom.volumeSlider.value = state.settings.volume;
  dom.speedSlider.value = state.settings.speed;
  dom.densitySlider.value = state.settings.density;
  dom.categorySelect.value = state.settings.category;
  renderGenreOptions();
  updateRangeLabels();
}

function renderGenreOptions() {
  if (!dom.genreSelect) return;
  const foundGenres = new Set(state.vocabulary.map((item) => item.genre).filter(Boolean));
  const genres = [...new Set([...GENRE_ORDER.filter((genre) => foundGenres.has(genre)), ...[...foundGenres].sort()])];
  dom.genreSelect.innerHTML = [
    '<option value="all">All Genres</option>',
    ...genres.map((genre) => `<option value="${escapeAttribute(genre)}">${escapeHtml(GENRE_LABELS[genre] || toTitleCase(genre))}</option>`)
  ].join("");
  if (!state.dataLoading && state.vocabulary.length && ![...genres, "all"].includes(state.settings.genre)) {
    state.settings.genre = "all";
  }
  dom.genreSelect.value = state.settings.genre;
}

function openSettings() {
  dom.settingsPanel.classList.add("is-open");
  dom.settingsPanel.setAttribute("aria-hidden", "false");
  dom.settingsButton.setAttribute("aria-expanded", "true");
}

function closeSettings() {
  dom.settingsPanel.classList.remove("is-open");
  dom.settingsPanel.setAttribute("aria-hidden", "true");
  dom.settingsButton.setAttribute("aria-expanded", "false");
}

function updateRangeLabels() {
  dom.volumeValue.textContent = `${Math.round(state.settings.volume * 100)}%`;
  dom.speedValue.textContent = `${Number(state.settings.speed).toFixed(2)}x`;
  dom.densityValue.textContent = String(state.settings.density);
}

function handleLanguageChange(event) {
  const checkbox = event.target;
  if (!checkbox.matches("input[type='checkbox']")) return;
  const selected = [...dom.languageGrid.querySelectorAll("input:checked")].map((input) => input.value);
  if (!selected.length) {
    checkbox.checked = true;
    showStatus("At least one language must remain active.");
    return;
  }
  state.settings.languages = selected;
  selected.forEach((lang) => loadLanguage(lang));
  persistAndRefresh();
}

function handleLevelClick(event) {
  const button = event.target.closest(".level-button");
  if (!button) return;
  const level = Number(button.dataset.level);
  const hasLevel = state.settings.levels.includes(level);
  if (hasLevel && state.settings.levels.length === 1) {
    showStatus("At least one difficulty level must remain active.");
    return;
  }
  state.settings.levels = hasLevel
    ? state.settings.levels.filter((item) => item !== level)
    : [...state.settings.levels, level].sort((a, b) => a - b);
  button.classList.toggle("is-active", !hasLevel);
  button.setAttribute("aria-pressed", String(!hasLevel));
  persistAndRefresh();
}

function persistAndRefresh() {
  saveSettings();
  updateFilteredWords();
  clearActiveWords();
}

/* 9. BOOKMARKS */
function openBookmarks() {
  renderBookmarks();
  dom.bookmarksDrawer.classList.add("is-open");
  dom.bookmarksDrawer.setAttribute("aria-hidden", "false");
  dom.bookmarkButton.setAttribute("aria-expanded", "true");
}

function closeBookmarks() {
  dom.bookmarksDrawer.classList.remove("is-open");
  dom.bookmarksDrawer.setAttribute("aria-hidden", "true");
  dom.bookmarkButton.setAttribute("aria-expanded", "false");
}

function isBookmarked(item) {
  return state.bookmarks.some((bookmark) => bookmark.id === item.id);
}

function toggleBookmark() {
  if (!state.selectedWord) return;
  if (isBookmarked(state.selectedWord)) {
    state.bookmarks = state.bookmarks.filter((bookmark) => bookmark.id !== state.selectedWord.id);
  } else {
    state.bookmarks.unshift({ ...state.selectedWord });
  }
  saveBookmarks();
  updateSaveButton();
  renderBookmarks();
}

function updateSaveButton() {
  if (!state.selectedWord) return;
  const saved = isBookmarked(state.selectedWord);
  dom.saveButton.innerHTML = `<i data-lucide="${saved ? "bookmark-minus" : "bookmark"}"></i><span>${saved ? "Remove" : "Save"}</span>`;
  refreshIcons();
}

function renderBookmarks() {
  if (!state.bookmarks.length) {
    dom.bookmarksList.innerHTML = '<p class="empty-state">No saved words yet. Let one arrive, then keep it.</p>';
    return;
  }
  dom.bookmarksList.innerHTML = state.bookmarks.map((item) => `
    <article class="bookmark-card">
      <button class="bookmark-open" type="button" data-id="${escapeAttribute(item.id)}" aria-label="Open ${escapeAttribute(item.name)}">
        <span class="bookmark-word">${escapeHtml(item.name)}</span>
        <span class="bookmark-meta">${item.lang.toUpperCase()} · Lv${item.lv} · ${escapeHtml(item.genre)}</span>
        <span class="bookmark-preview">${escapeHtml(item.desc)}</span>
      </button>
      <button class="icon-button compact bookmark-remove" type="button" data-id="${escapeAttribute(item.id)}" aria-label="Remove ${escapeAttribute(item.name)}">
        <i data-lucide="trash-2"></i>
      </button>
    </article>
  `).join("");
  refreshIcons();
}

function handleBookmarkListClick(event) {
  const remove = event.target.closest(".bookmark-remove");
  const open = event.target.closest(".bookmark-open");
  if (remove) {
    state.bookmarks = state.bookmarks.filter((bookmark) => bookmark.id !== remove.dataset.id);
    saveBookmarks();
    renderBookmarks();
    updateSaveButton();
    return;
  }
  if (open) {
    const item = state.bookmarks.find((bookmark) => bookmark.id === open.dataset.id);
    if (item) {
      closeBookmarks();
      openModal(item);
    }
  }
}

/* 10. JSON IMPORT */
function generateTemplate() {
  const template = [
    {
      name: "ma",
      reading: "",
      desc: "A quiet interval where form and emptiness meet.",
      lv: 1,
      lang: "ja",
      category: "custom",
      genre: "custom"
    }
  ];
  dom.jsonInput.value = JSON.stringify(template, null, 2);
}

function importJson() {
  let parsed;
  try {
    parsed = JSON.parse(dom.jsonInput.value);
  } catch (error) {
    dom.importStatus.textContent = "Invalid JSON. Please provide an array.";
    return;
  }

  if (!Array.isArray(parsed)) {
    dom.importStatus.textContent = "Import must be a JSON array.";
    return;
  }

  let imported = 0;
  let skipped = 0;
  const words = [];
  parsed.forEach((item) => {
    const normalized = normalizeVocabularyItem({
      ...item,
      category: VALID_CATEGORIES.has(cleanText(item.category).toLowerCase()) ? item.category : "custom",
      genre: isValidGenre(cleanText(item.genre).toLowerCase()) ? item.genre : "custom"
    }, "custom");
    if (normalized) {
      words.push(normalized);
      imported += 1;
    } else {
      skipped += 1;
    }
  });

  const existing = new Set(state.customWords.map((item) => item.id));
  const fresh = words.filter((item) => !existing.has(item.id));
  state.customWords.push(...fresh);
  const customIds = new Set(state.customWords.map((item) => item.id));
  state.vocabulary = state.vocabulary.filter((item) => !customIds.has(item.id)).concat(state.customWords);
  saveCustomWords();
  updateFilteredWords();
  renderGenreOptions();
  dom.importStatus.textContent = `Imported ${fresh.length} entries. Skipped ${skipped + (imported - fresh.length)}.`;
}

/* 11. LOCAL STORAGE */
function loadFromStorage() {
  const savedSettings = readStorage(STORAGE_KEYS.settings, {});
  state.settings = {
    ...DEFAULT_SETTINGS,
    ...savedSettings,
    languages: sanitizeList(savedSettings.languages, VALID_LANGS, DEFAULT_SETTINGS.languages),
    levels: sanitizeList(savedSettings.levels, new Set(LEVELS), DEFAULT_SETTINGS.levels).map(Number),
    category: ["all", "vocabulary", "tech", "custom"].includes(savedSettings.category) ? savedSettings.category : DEFAULT_SETTINGS.category,
    genre: savedSettings.genre === "all" || isValidGenre(savedSettings.genre) ? savedSettings.genre : DEFAULT_SETTINGS.genre,
    volume: clampNumber(savedSettings.volume, 0, 1, DEFAULT_SETTINGS.volume),
    speed: clampNumber(savedSettings.speed, 0.35, 2.2, DEFAULT_SETTINGS.speed),
    density: Math.round(clampNumber(savedSettings.density, 6, 120, DEFAULT_SETTINGS.density)),
    audioMode: ["ambient", "custom"].includes(savedSettings.audioMode) ? savedSettings.audioMode : DEFAULT_SETTINGS.audioMode
  };
  state.audio.muted = true;
  state.customWords = readStorage(STORAGE_KEYS.customWords, []).map((item) => normalizeVocabularyItem(item, "custom")).filter(Boolean);
  state.bookmarks = readStorage(STORAGE_KEYS.bookmarks, []).map((item) => normalizeVocabularyItem(item, "custom")).filter(Boolean);
  state.vocabulary.push(...state.customWords);
}

function saveSettings() {
  localStorage.setItem(STORAGE_KEYS.settings, JSON.stringify(state.settings));
}

function saveBookmarks() {
  localStorage.setItem(STORAGE_KEYS.bookmarks, JSON.stringify(state.bookmarks));
}

function saveCustomWords() {
  localStorage.setItem(STORAGE_KEYS.customWords, JSON.stringify(state.customWords));
}

function readStorage(key, fallback) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch (error) {
    return fallback;
  }
}

function sanitizeList(value, allowed, fallback) {
  if (!Array.isArray(value)) return [...fallback];
  const clean = value.filter((item) => allowed.has(item));
  return clean.length ? clean : [...fallback];
}

function clampNumber(value, min, max, fallback) {
  const number = Number(value);
  if (!Number.isFinite(number)) return fallback;
  return Math.min(max, Math.max(min, number));
}

/* 12. INIT */
function bindEvents() {
  dom.settingsButton.addEventListener("click", openSettings);
  dom.closeSettingsButton.addEventListener("click", closeSettings);
  dom.bookmarkButton.addEventListener("click", openBookmarks);
  dom.closeBookmarksButton.addEventListener("click", closeBookmarks);
  dom.soundButton.addEventListener("click", toggleSound);
  dom.languageGrid.addEventListener("change", handleLanguageChange);
  dom.levelButtons.addEventListener("click", handleLevelClick);
  dom.categorySelect.addEventListener("change", () => {
    state.settings.category = dom.categorySelect.value;
    persistAndRefresh();
  });
  dom.genreSelect.addEventListener("change", () => {
    state.settings.genre = dom.genreSelect.value;
    persistAndRefresh();
  });
  dom.speedSlider.addEventListener("input", () => {
    state.settings.speed = Number(dom.speedSlider.value);
    updateRangeLabels();
    saveSettings();
  });
  dom.densitySlider.addEventListener("input", () => {
    state.settings.density = Number(dom.densitySlider.value);
    updateRangeLabels();
    saveSettings();
  });
  dom.volumeSlider.addEventListener("input", () => {
    state.settings.volume = Number(dom.volumeSlider.value);
    updateRangeLabels();
    applyVolume();
    saveSettings();
  });
  dom.audioMode.addEventListener("change", () => {
    state.settings.audioMode = dom.audioMode.value;
    saveSettings();
    if (!state.audio.muted) startAudioSource();
  });
  dom.audioFileInput.addEventListener("change", (event) => handleAudioFile(event.target.files[0]));
  dom.audioDropZone.addEventListener("dragover", (event) => {
    event.preventDefault();
    dom.audioDropZone.classList.add("is-dragging");
  });
  dom.audioDropZone.addEventListener("dragleave", () => dom.audioDropZone.classList.remove("is-dragging"));
  dom.audioDropZone.addEventListener("drop", (event) => {
    event.preventDefault();
    dom.audioDropZone.classList.remove("is-dragging");
    handleAudioFile(event.dataTransfer.files[0]);
  });
  dom.templateButton.addEventListener("click", generateTemplate);
  dom.importButton.addEventListener("click", importJson);
  dom.closeModalButton.addEventListener("click", closeModal);
  dom.modalBackdrop.addEventListener("click", (event) => {
    if (event.target === dom.modalBackdrop) closeModal();
  });
  dom.googleButton.addEventListener("click", () => searchSelectedWord("google"));
  dom.wikiButton.addEventListener("click", () => searchSelectedWord("wiki"));
  dom.saveButton.addEventListener("click", toggleBookmark);
  dom.bookmarksList.addEventListener("click", handleBookmarkListClick);
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      if (dom.modalBackdrop.classList.contains("is-open")) closeModal();
      closeSettings();
      closeBookmarks();
    }
  });
  window.addEventListener("resize", clearActiveWords);
}

async function init() {
  console.info("Wordfall should be served through a local static server, for example: python -m http.server");
  loadFromStorage();
  renderSettingsControls();
  bindEvents();
  updateSoundButton();
  refreshIcons();
  await loadInitialData();
  requestAnimationFrame(animationLoop);
}

function showStatus(message) {
  dom.statusMessage.textContent = message;
  dom.statusMessage.classList.add("is-visible");
  window.clearTimeout(state.statusTimer);
  state.statusTimer = window.setTimeout(() => {
    dom.statusMessage.classList.remove("is-visible");
  }, 3800);
}

function refreshIcons() {
  if (window.lucide) window.lucide.createIcons();
}

function toTitleCase(value) {
  return String(value).replace(/-/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
}

function escapeHtml(value) {
  return String(value).replace(/[&<>"']/g, (char) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);
}

function escapeAttribute(value) {
  return escapeHtml(value).replace(/`/g, "&#096;");
}

init();
