        <button id="googleButton" class="text-button" type="button">
          <i data-lucide="search"></i>
          <span>Google</span>
        </button>
        <button id="wikiButton" class="text-button" type="button">
          <i data-lucide="book-open"></i>
          <span>Wikipedia</span>
        </button>
        <button id="saveButton" class="text-button primary" type="button">
          <i data-lucide="bookmark"></i>
          <span>Save</span>
        </button>
      </div>
    </article>
  </div>

  <script src="app.js"></script>
</body>
</html>
